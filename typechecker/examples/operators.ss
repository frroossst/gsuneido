// this file is to demonstrate that without knowing the types of the operands we can reasonably well
// infer the types of the result of an operator 
class {
    Operate(x, y) {
        a = x + y
        a = x - y
        a = x * y
        a = x / y
        a = x % y
        a = x ^ y
        a = x & y
        a = x $ y 
    }
}