class
    {
    UseNumber()
        {
        return Number("42")
        }
    UseString()
        {
        return String(123)
        }
    UseObject()
        {
        return Object(1, 2, 3)
        }
    UseRecord()
        {
        return Record(a: 1, b: 2)
        }
    UseDate()
        {
        return Date("20240101")
        }
    UseDisplay()
        {
        return Display(123)
        }
    UseType(x)
        {
        return Type(x)
        }
    BracketObject()
        {
        return [1, 2, 3]
        }
    BracketRecord()
        {
        return [a: 1, b: 2]
        }
    }
