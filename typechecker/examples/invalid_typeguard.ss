class
    {
    InvalidString(x)
        {
        if Type(x) is "Broski"
            return x
        return false
        }

    LowercaseString(x)
        {
        if Type(x) is "string"
            return x
        return false
        }

    ValidString(x)
        {
        if Type(x) is "String"
            return x
        return false
        }
    }

